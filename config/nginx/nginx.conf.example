server {
    listen 80;
    server_name SEU-DOMINIO;
}

server {
    listen 443 ssl;
    server_name SEU-DOMINIO;

    # Certificados configurados no ambiente de producao
    # Os arquivos privados nao devem ser publicados.

    location /server {
        proxy_pass http://localhost:8080/server;
    }

    location / {
        proxy_pass http://localhost:4000;
    }

    location /ojs {
        proxy_pass http://localhost:8443;
    }
}